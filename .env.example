# Python agent backend. Server-side only — never exposed to the browser.
AGENT_API_URL=http://127.0.0.1:8000

# Absolute site origin, no trailing slash. Required in production for
# canonical URLs, Open Graph tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Where spoken answers get their audio: "browser" or "elevenlabs".
# Defaults to "browser" so nothing spends ElevenLabs credits unless asked.
# Inlined at build time — restart the dev server after changing it, or flip
# it instantly from the console with:
#   localStorage.setItem("portfolio.agent.ttsProvider", "browser")
NEXT_PUBLIC_TTS_PROVIDER=browser
